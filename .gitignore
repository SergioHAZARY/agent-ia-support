# --- Secrets : ne JAMAIS committer -------------------------------------------
.env
.env.*
!.env.example
# Coffre local des identifiants — reste sur le poste, jamais sur GitHub
SECRETS.local.md
*.local.md
*.secrets

# Configs VPN (contiennent des clés privées)
*.conf
# Fichiers de connexion Bureau à distance
*.rdp
# Clés et certificats
*.key
*.pem
*.pfx

# Sauvegardes de base
backups/*
!backups/.gitkeep
*.sql.gz

# Token cache Microsoft Graph (OAuth device code flow)
scripts/.outlook_token_cache.json

# --- Généré / local ----------------------------------------------------------
# Export DOCX du document — régénéré depuis le HTML
*.docx
__pycache__/
*.pyc
.venv/
.claude/settings.local.json

.DS_Store
Thumbs.db
