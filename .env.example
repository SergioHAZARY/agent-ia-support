# =============================================================================
# Copier en .env et renseigner. Ne jamais committer .env.
#   cp .env.example .env
# =============================================================================

# --- Domaine public ----------------------------------------------------------
# Doit pointer sur la VM (enregistrement A). Caddy obtient le certificat seul.
N8N_HOST=support.exemple.com
TIMEZONE=Europe/Paris

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=agent
POSTGRES_PASSWORD=          # openssl rand -base64 24

# --- n8n ---------------------------------------------------------------------
# L'éditeur n8n est protégé par Caddy, pas par n8n (les variables
# N8N_BASIC_AUTH_* ont disparu en n8n 1.x). Générer le hash bcrypt avec :
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'votre-mot-de-passe'
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD_HASH=    # $2a$14$...  (garder les guillemets simples si le shell râle)
# Chiffre le coffre de credentials. À conserver hors de la VM :
# sans cette clé, les credentials d'une sauvegarde sont irrécupérables.
N8N_ENCRYPTION_KEY=         # openssl rand -hex 32

# --- Claude API --------------------------------------------------------------
# console.anthropic.com → API keys. Poser un plafond de dépense mensuel
# et une alerte à 80 % dès la création de la clé (§16).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Modèle léger pour la seule question « est-ce un ticket ? »
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001

# --- Sauvegardes -------------------------------------------------------------
BACKUP_RETENTION_DAYS=30

# --- Variables n8n (à créer dans Settings > Variables de l'instance n8n) ------
# Le token Telegram du bot est déjà en variable n8n : TELEGRAM_BOT_TOKEN
# Ajouter ces variables dans l'interface n8n :
#   CLICKUP_API_TOKEN=pk_...         # ClickUp API Personal Token
#   CLICKUP_LIST_ID=901222267724     # Liste "Escalades Agent IA" (Regard Beauty)
#   TELEGRAM_DEVMG_CHAT_ID=-5219441607  # Groupe Telegram DEV MG (techniciens)

# =============================================================================
# Tout le reste — jetons Telegram, compte Jira, comptes de service annuaire —
# se saisit dans le coffre de credentials n8n, jamais ici et jamais en base.
# Les tables ne stockent que des `credential_ref`, c'est-à-dire des NOMS.
# =============================================================================
