# Copier en .env, renseigner, puis : chmod 600 .env (ou droits restreints sous Windows)
# Ce fichier contient le mot de passe du compte de service — jamais dans git.

# --- Contrôleur de domaine ---------------------------------------------------
AD_HOST=192.168.25.230
AD_DOMAIN=FSAGET.PRI
AD_BASE_DN=DC=FSAGET,DC=PRI

# --- Compte de service à DROITS DÉLÉGUÉS MINIMAUX ----------------------------
# Créé par setup-ad-service-account.ps1. JAMAIS un administrateur de domaine.
AD_BIND_USER=svc-agent@FSAGET.PRI
AD_BIND_PASS=

# --- Périmètre autorisé ------------------------------------------------------
# Liste blanche des OU où le service peut écrire, séparées par ';'.
# Une demande hors de ces OU est refusée avant tout appel au DC.
ALLOWED_OUS=OU=Agent,OU=Utilisateurs,DC=FSAGET,DC=PRI

# Groupes jamais touchés (une valeur par défaut sûre est déjà codée ;
# ne compléter que pour ajouter vos propres groupes sensibles).
# PRIVILEGED_GROUPS=domain admins;enterprise admins;...

# --- API ---------------------------------------------------------------------
# Jeton partagé avec n8n. Générer : openssl rand -hex 32
API_TOKEN=

# --- TLS ---------------------------------------------------------------------
# true en production (le certificat du DC doit être valide/de confiance).
# Passer à false UNIQUEMENT le temps d'un test initial.
AD_TLS_VERIFY=true
